# ----- Runtime / deployment artifacts (do NOT commit) -----
# service.log / service.pid are written by run_service.sh to repo root;
# output/ contains per-task sidecars (status.json, instances.json, ...);
# dataset_output/ is what `python -m scripts.algorithm.run_pipeline` writes
# when invoked directly (not through the FastAPI service).
service.log
service.pid
service.err
output/
dataset_output/
data/output/

